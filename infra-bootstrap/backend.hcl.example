# Copy this file to backend.hcl (gitignored) and fill in your real
# bucket name from state-backend-setup/create-backend.sh's output,
# then run:
#   terraform init -backend-config=backend.hcl
#
# Same bucket + lock table as the root idp-platform module, but a
# different `key` — this is what keeps the cluster's state and the
# namespaces' state independent despite sharing storage.

bucket         = "idp-platform-tfstate"
key            = "infra-bootstrap/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "idp-platform-tf-locks"
encrypt        = true
